  Choices:
  - Label: "\uC804\uC220\uC11C\uB97C \uD3BC\uCE5C\uB2E4"
    ResultText: "\uC804\uC870\uC5D0 \uC228\uACA8\uC9C4 \uACE0\uB300\uC758 \uC804\uC220\uC744
