  EventId: WarRelic
  Title: "\uC804\uC7C1 \uC720\uBB3C"
  Body: "\uC804\uC7A5\uD130 \uAD6C\uC11D\uC5D0\uC11C \uC624\uB798\uB41C \uC804\uC7C1\uC758
    \uD754\uC801\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4.\n\uB179\uC2A8 \uAC11\uC637
    \uC870\uAC01\uC5D0\uC11C \uC544\uC9C1\uB3C4 \uC804\uD22C\uC758 \uAE30\uC6B4\uC774
    \uB290\uAEF4\uC9D1\uB2C8\uB2E4.\n\uADF8 \uC544\uB798\uB85C \uC218\uC2B5\uB418\uC9C0
    \uBABB\uD55C \uC720\uD574\uAC00 \uD759\uC5D0 \uBC18\uCBE4 \uBB3B\uD600 \uC788\uC2B5\uB2C8\uB2E4."
  Illustration: {fileID: 21300000, guid: 66d7b33bafff8cd47aa297eea536ef8c, type: 3}
  Choices:
  - Label: "\uC720\uBB3C\uC744 \uC218\uC2B5\uD55C\uB2E4"
    ResultText: "\uD759\uC744 \uAC77\uC5B4\uB0B4\uC790 \uAC11\uC637\uC5D0\uC11C \uB5A8\uC5B4\uC838
      \uB098\uC628 \uAC15\uD654\uC11D \uC870\uAC01\uC774 \uB4DC\uB7EC\uB0AC\uC2B5\uB2C8\uB2E4.\n\uBA3C\uC800
      \uC2A4\uB7EC\uC9C4 \uC774\uB984\uB4E4\uC774 \uC190\uB05D\uC5D0 \uB2FF\uB294
      \uB4EF\uD569\uB2C8\uB2E4.\n[\uC7A5\uBE44 \uAC15\uD654\uC11D 3\uAC1C + \uD658\uC0DD
      \uD3EC\uC778\uD2B8 5 \uD68D\uB4DD]"
    FailResultText: 
    SuccessRate: 1
    SuccessRewards:
    - Type: 2
      Item: 104
      IntValue: 3
