  EventId: LoneVeteran
  Title: "\uACE0\uB3C5\uD55C \uB178\uBCD1"
  Body: "\uD55C\uCABD \uB2E4\uB9AC\uAC00 \uBD88\uD3B8\uD55C \uB178\uBCD1\uC774 \uB9C9\uC0AC
    \uBC16\uC5D0 \uD640\uB85C \uC549\uC544 \uC788\uC2B5\uB2C8\uB2E4.\n\uBE44\uC5B4
    \uC788\uB294 \uC220\uC794\uC744 \uB9CC\uC9C0\uC791\uAC70\uB9AC\uBA70 \uADF8\uAC00
    \uC62C\uB824\uB2E4\uBD05\uB2C8\uB2E4.\n\"\uC7A5\uAD70\uB2D8, \uC81C\uAC00 \uB2F9\uC2E0
    \uAC19\uC558\uC744 \uB54C\uC758 \uC774\uC57C\uAE30\uB97C \uD574\uB4DC\uB9B4\uAE4C\uC694?\""
  Illustration: {fileID: 21300000, guid: bacb084d52b4707439cb7bdcd22640e3, type: 3}
  Choices:
  - Label: "\uC774\uC57C\uAE30\uB97C \uB4E3\uB294\uB2E4"
    ResultText: "\uB178\uBCD1\uC740 \uC80A\uC740 \uB0A0\uC758 \uD589\uAD70\uC744
      \uBC24\uC0C8 \uB4E4\uB824\uC8FC\uC5C8\uC2B5\uB2C8\uB2E4.\n\uADF8 \uAC78\uC74C\uAC78\uC774\uB97C
      \uD749\uB0B4 \uB0B4\uC790 \uBD80\uB300\uC758 \uBC1C\uC774 \uD55C\uACB0 \uAC00\uBCBC\uC6CC\uC9D1\uB2C8\uB2E4.\n[\uC774\uB3D9\uC18D\uB3C4
      +10% \uD2B9\uC131]"
    FailResultText: 
    SuccessRate: 1
    SuccessRewards:
    - Type: 1
      Item: -1
      IntValue: 507
